DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/secure_app
# Ключ подписи JWT.
SECRET_KEY=change-me
APP_ENV=dev
PORT=8000
# Поддерживается только argon2id.
HASH_SCHEME=argon2id
ARGON2_TIME_COST=3
# Память на один хеш в КиБ.
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=2
# Время жизни JWT в минутах.
TOKEN_EXPIRE_MINUTES=60
